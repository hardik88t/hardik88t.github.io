---
// The plain index of all eight projects: an accessible table beside the pinboard, always available on desktop.
import { cases, pad } from '../lib/cases';
---
<div class="work-index">
  <table>
    <caption class="sr-only">All eight projects</caption>
    <thead>
      <tr><th scope="col">No.</th><th scope="col">Project</th><th scope="col">Type</th><th scope="col">Year</th><th scope="col">One line</th><th scope="col"><span class="sr-only">Case study</span></th></tr>
    </thead>
    <tbody>
      {cases.map((c, i) => (
        <tr>
          <td class="mono">{pad(i)}</td>
          <th scope="row">{c.title}</th>
          <td>{c.type}</td>
          <td class="mono">{c.year}</td>
          <td>{c.oneLiner}</td>
          <td><a class="link-hand" href={`#work-${c.slug}`}>Case study<span class="sr-only"> of {c.title}</span></a></td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
