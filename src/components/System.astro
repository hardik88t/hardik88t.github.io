---
// The system view: the concept, tokens and components, shown with the same rules the portfolio follows.
// Contrast numbers are computed at build time from the same palette the CSS uses.
import { light, dark } from '../lib/palette';
import { contrast } from '../lib/contrast';
import { headingAxes, tilt, variant } from '../lib/seed';
import PrintArt from './PrintArt.astro';
import Edit from './Edit.astro';
import Print from './Print.astro';
import { print, proof } from '../lib/screens';
import { roughRect } from '../lib/rough';

const r = (fg: string, bg: string) => contrast(fg, bg).toFixed(1) + ':1';
const swatches = [
  { name: 'paper', hex: light.paper, use: 'Background. Cool off-white.' },
  { name: 'ink', hex: light.ink, use: 'Text, buttons, linework.' },
  { name: 'ink-2', hex: light.ink2, use: 'Secondary text.' },
  { name: 'rule', hex: light.rule, use: 'Hairlines. Decoration only.' },
  { name: 'riso blue', hex: light.blue, use: 'Links and focus (AA text).' },
  { name: 'pink', hex: light.pink, use: 'Strokes and flicks. Decoration only.' },
  { name: 'pink ink', hex: light.pinkInk, use: 'Handwritten correction text (AA).' },
  { name: 'yellow', hex: light.yellow, use: 'Highlight behind ink text.' },
  { name: 'kintsugi gold', hex: light.gold, use: 'Repair lines. Never text.' },
  { name: 'teal (project ink)', hex: light.teal, use: 'Project prints only. Never UI or text.' },
  { name: 'orange (project ink)', hex: light.orange, use: 'Project prints only. Never UI or text.' },
];
const ratios = [
  { label: 'pink ink on paper (correction)', fg: light.pinkInk, bgL: light.paper, bgD: dark.paper, fgD: dark.pinkInk, use: 'Handwritten correction text' },
  { label: 'ink on highlight', fg: light.onYellow, bgL: light.highlight, bgD: dark.highlight, fgD: dark.onYellow, use: 'Highlight text' },
  { label: 'ink on paper', fg: light.ink, bgL: light.paper, bgD: dark.paper, fgD: dark.ink, use: 'Body text' },
  { label: 'ink-2 on paper', fg: light.ink2, bgL: light.paper, bgD: dark.paper, fgD: dark.ink2, use: 'Secondary text' },
  { label: 'riso blue on paper', fg: light.blue, bgL: light.paper, bgD: dark.paper, fgD: dark.blue, use: 'Links, focus' },
  { label: 'ink on yellow', fg: light.onYellow, bgL: light.yellow, bgD: dark.yellow, fgD: dark.onYellow, use: 'Highlight text' },
  { label: 'ink on pink', fg: light.onPink, bgL: light.pink, bgD: dark.pink, fgD: dark.onPink, use: 'Correction text' },
  { label: 'pink on paper', fg: light.pink, bgL: light.paper, bgD: dark.paper, fgD: dark.pink, use: 'Decoration only, never text' },
  { label: 'gold on paper', fg: light.gold, bgL: light.paper, bgD: dark.paper, fgD: dark.gold, use: 'Hairlines only, never text' },
];
const comps = [
  { name: 'Button', note: 'Perfect. Solid ink, nothing rotates.', why: 'Free: a border and a colour.' },
  { name: 'Link', note: 'Straight text, hand-drawn underline.', why: 'Free: one SVG stroke under the text.' },
  { name: 'Print card', note: 'Riso sheet, two inks. Caption stays straight.', why: 'Free: a transform on a wrapper.' },
  { name: 'Margin note', note: 'Casual Recursive with a hand arrow.', why: 'Free: static text and one SVG arrow.' },
  { name: 'Edit', note: 'A pink pen strike, a caret and a handwritten correction. Screen readers hear only the correction.', why: 'Free: SVG strokes and reserved space, no reflow.' },
  { name: 'Rule', note: 'A hairline that stops 1px short.', why: 'Free: a 1px pseudo-element.' },
  { name: 'Kintsugi repair', note: 'A gold hairline shows the repair.', why: 'Free: an SVG stroke, never text.' },
  { name: 'Dialog', note: 'Perfect. Escape closes, focus returns.', why: 'Free: nothing imperfect in it.' },
];
const checks = [
  'No layout shift: transforms, paint and SVG only.',
  'No JS for imperfections: seeds run at build time.',
  'AA contrast: every text pair is printed above.',
  'Deterministic: the same slug gives the same tilt.',
  'Reduced motion: the settle and nudges switch off.',
  'At most about three imperfections per viewport.',
  'Project inks (teal, orange) appear on project prints only.',
  'Full-colour proofs load on demand; the board and the home ship no proof images.',
];
---
<section class="view view--system" id="system" data-title="The system · Perfect Imperfect" aria-labelledby="system-title">
  <div class="wrap">
    <section class="sys-section sys-hero" aria-labelledby="system-title">
      <p class="mono">Perfect Imperfect · a design system</p>
      <h1 id="system-title" class="wordmark display-misreg" tabindex="-1"><span class="kern">im</span>perfect</h1>
      <p class="mono sys-sub">Two words: i'm perfect. The gap is the idea, shown plainly.</p>
    </section>

    <section class="sys-section" aria-labelledby="rule-title">
      <h2 id="rule-title" class="sys-rule" style={`font-variation-settings:${headingAxes('rule')}`}>If an imperfection causes a problem, it isn't the imperfection.</h2>
    </section>

    <section class="sys-section" aria-labelledby="principles-title">
      <h2 id="principles-title">Principles</h2>
      <ol class="principles" role="list">
        <li><h3>Deliberate</h3><p>Seeded at build time from each slug. The same page on every visit.</p></li>
        <li><h3>Free</h3><p>Transforms, paint and SVG only. No shift, no JS, no blur on text.</p></li>
        <li><h3>Budgeted</h3><p>About three noticeable imperfections per viewport.</p></li>
        <li><h3>Accessibility is never imperfect</h3><p>Semantics, focus, contrast and screen-reader text stay perfect.</p></li>
        <li>
          <h3>Perfection is reserved for what matters</h3>
          <p>Buttons, focus rings, fields, email, numbers and dialogs stay straight and solid.</p>
          <p class="psych"><strong>Isolation effect (Von Restorff).</strong> The one straight element is the one people press.</p>
          <p class="psych"><strong>Pratfall effect.</strong> A small, honest flaw makes a competent person likeable. Kintsugi shows repairs in gold.</p>
        </li>
      </ol>
    </section>

    <section class="sys-section" aria-labelledby="tokens-title">
      <h2 id="tokens-title">Tokens</h2>
      <h3 class="sub">Colour, riso inks on paper</h3>
      <ul class="swatches" role="list">
        {swatches.map((s, i) => (
          <li class="swatch">
            <span class="swatch__chip" style={`background:${s.hex};border-radius:${['42% 58% 51% 49% / 55% 46% 54% 45%', '58% 42% 46% 54% / 44% 56% 44% 56%', '47% 53% 56% 44% / 50% 42% 58% 50%', '53% 47% 44% 56% / 46% 58% 42% 54%'][i % 4]}`} aria-hidden="true"></span>
            <span class="swatch__name">{s.name}</span>
            <span class="mono">{s.hex}</span>
            <span class="swatch__use">{s.use}</span>
          </li>
        ))}
      </ul>

      <h3 class="sub">Contrast, computed at build time</h3>
      <div class="table-wrap">
        <table class="ratios">
          <thead><tr><th scope="col">Pair</th><th scope="col">Light</th><th scope="col">Dark</th><th scope="col">Use</th></tr></thead>
          <tbody>
            {ratios.map((row) => (
              <tr>
                <th scope="row">{row.label}</th>
                <td data-label="Light">{r(row.fg, row.bgL)}</td>
                <td data-label="Dark">{r(row.fgD, row.bgD)}</td>
                <td>{row.use}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h3 class="sub">Type, two variable families</h3>
      <div class="specimens">
        <p class="spec spec--display" style="font-variation-settings:'WONK' 0, 'SOFT' 40">Fraunces, WONK 0: Perfect imperfect</p>
        <p class="spec spec--display" style="font-variation-settings:'WONK' 1, 'SOFT' 60">Fraunces, WONK 1: Perfect imperfect</p>
        <p class="spec" style="font-variation-settings:'CASL' 0, 'MONO' 0">Recursive, CASL 0: Good software feels obvious.</p>
        <p class="spec" style="font-variation-settings:'CASL' 1, 'slnt' -8">Recursive, CASL 1, slnt -8: Good software feels obvious.</p>
        <p class="spec mono" style="font-variation-settings:'MONO' 1">Recursive, MONO 1: Ahmedabad, India · 2026</p>
      </div>

      <h3 class="sub">Imperfection tokens</h3>
      <div class="tokens-grid">
        <figure class="tok"><span class="tok__demo"><span class="tok__plate" style="--tilt:var(--tilt-xs)"></span></span><figcaption class="mono">--tilt-xs 0.35deg</figcaption></figure>
        <figure class="tok"><span class="tok__demo"><span class="tok__plate" style="--tilt:var(--tilt-sm)"></span></span><figcaption class="mono">--tilt-sm 0.8deg</figcaption></figure>
        <figure class="tok"><span class="tok__demo"><span class="tok__plate" style="--tilt:var(--tilt-md)"></span></span><figcaption class="mono">--tilt-md 1.6deg</figcaption></figure>
        <figure class="tok"><span class="tok__demo"><span class="tok__nudge" style="transform:translate(var(--nudge-xs),0)"></span></span><figcaption class="mono">--nudge-xs 1px</figcaption></figure>
        <figure class="tok"><span class="tok__demo"><span class="tok__nudge" style="transform:translate(var(--nudge-sm),0)"></span></span><figcaption class="mono">--nudge-sm 3px</figcaption></figure>
        <figure class="tok"><span class="tok__demo"><span class="tok__nudge" style="transform:translate(var(--nudge-md),0)"></span></span><figcaption class="mono">--nudge-md 7px</figcaption></figure>
        <figure class="tok"><span class="tok__demo"><span class="tok__misreg">Print</span></span><figcaption class="mono">--misreg 1.5px</figcaption></figure>
        <figure class="tok"><span class="tok__demo tok__grain"></span><figcaption class="mono">--grain 0.06</figcaption></figure>
        <figure class="tok"><span class="tok__demo"><span class="tok__bleed">Ink</span></span><figcaption class="mono">--ink-bleed 0.6px</figcaption></figure>
      </div>
    </section>

    <section class="sys-section" aria-labelledby="components-title">
      <h2 id="components-title">Components</h2>
      <ul class="comps" role="list">
        <li class="comp">
          <div class="comp__demo"><a class="btn btn--primary" href="#home">Start a project</a></div>
          <h3>{comps[0]?.name}</h3><p>{comps[0]?.note}</p><p class="mono">{comps[0]?.why}</p>
        </li>
        <li class="comp">
          <div class="comp__demo"><a class="link-hand" href="#home">See the work<svg class="mark mark--underline" viewBox="0 0 200 12" preserveAspectRatio="none" aria-hidden="true"><use href={`#m-underline-${['a','b','c'][variant('sys-link', 3)] ?? 'a'}`}></use></svg></a></div>
          <h3>{comps[1]?.name}</h3><p>{comps[1]?.note}</p><p class="mono">{comps[1]?.why}</p>
        </li>
        <li class="comp">
          <div class="comp__demo comp__demo--print"><span class="print print--demo" style={`--spot:#6366F1;--tilt:${tilt('system:print')};`}><span class="print__sheet"><PrintArt slug="dhi" /></span></span></div>
          <h3>{comps[2]?.name}</h3><p>{comps[2]?.note}</p><p class="mono">{comps[2]?.why}</p>
        </li>
        <li class="comp">
          <div class="comp__demo"><p class="note note--demo"><svg class="note__arrow" viewBox="0 0 24 30" aria-hidden="true" focusable="false"><path vector-effect="non-scaling-stroke" d="M9 28 C7 19 11 12 17 5 M12 9 L17 4 L19 11" /></svg><span>Start here if the screen feels off.</span></p></div>
          <h3>{comps[3]?.name}</h3><p>{comps[3]?.note}</p><p class="mono">{comps[3]?.why}</p>
        </li>
        <li class="comp">
          <div class="comp__demo"><p class="edit-demo">Build it for the <Edit word="perfect" correction="human" seed="edit:system" /> user.</p></div>
          <h3>{comps[4]?.name}</h3><p>{comps[4]?.note}</p><p class="mono">{comps[4]?.why}</p>
        </li>
        <li class="comp">
          <div class="comp__demo"><div class="rule-demo hairline-short" aria-hidden="true"></div></div>
          <h3>{comps[5]?.name}</h3><p>{comps[5]?.note}</p><p class="mono">{comps[5]?.why}</p>
        </li>
        <li class="comp">
          <div class="comp__demo"><div class="plate kintsugi-demo"><p>A repaired card.</p><svg class="card__repair" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><path class="kintsugi-line" d="M99 0 L95 12 L100 26 L96 40 L100 56 L95 70 L99 86 L96 100" /></svg></div></div>
          <h3>{comps[6]?.name}</h3><p>{comps[6]?.note}</p><p class="mono">{comps[6]?.why}</p>
        </li>
        <li class="comp">
          <div class="comp__demo"><button type="button" class="btn btn--quiet" data-open-dialog="dlg-system-demo">Open the dialog</button></div>
          <h3>{comps[7]?.name}</h3><p>{comps[7]?.note}</p><p class="mono">{comps[7]?.why}</p>
        </li>
      </ul>
      <dialog id="dlg-system-demo" class="dialog" aria-labelledby="dlg-system-demo-title">
        <div class="dialog__inner">
          <div class="dialog__head">
            <h3 id="dlg-system-demo-title">A perfect dialog</h3>
            <button type="button" class="btn btn--quiet dialog__close" data-close>Close</button>
          </div>
          <p>Straight, solid, high contrast. Escape closes it and focus returns to the button.</p>
        </div>
      </dialog>
    </section>

    <section class="sys-section" aria-labelledby="v4-title">
      <h2 id="v4-title">Added in the maximal version</h2>
      <p class="mono">Every new piece follows the same rule. Decoration may be imperfect. Buttons, text, focus and the email stay perfect.</p>
      <ul class="v4-grid" role="list">
        <li class="v4-item">
          <div class="v4-demo v4-demo--sheet" aria-hidden="true">
            <span class="frame v4-frame"><span class="frame__media"><Print name="wholesale-os" fill fix="tape" seedKey="sys:sheet" /><svg class="frame__circle" viewBox="0 0 200 80" preserveAspectRatio="none" focusable="false"><use href="#m-circle-a"></use></svg></span></span>
            <span class="frame v4-frame"><span class="frame__media"><Print name="paper-studio" fill fix="none" seedKey="sys:sheet2" /></span></span>
          </div>
          <h3>Contact sheet</h3>
          <p>Six real screens in a sideways strip. The best frame is circled by hand.</p>
          <p class="mono"><strong>Where the imperfection is:</strong> the circle and the frame offsets. <strong>Why it's free:</strong> SVG and transforms, and the scroll is native.</p>
        </li>
        <li class="v4-item">
          <div class="v4-demo" aria-hidden="true">
            <span class="stamp v4-stamp" style="--tilt:calc(var(--tilt-xs) * -1)"><svg class="stamp__edge" viewBox="0 0 100 100" preserveAspectRatio="none" focusable="false"><path vector-effect="non-scaling-stroke" d={roughRect('system:stamp')} /></svg><span class="stamp__num mono">01</span><span class="stamp__title">Web apps</span></span>
          </div>
          <h3>Stamp</h3>
          <p>A rubber stamp for services and tags: a rough-cut edge in pink ink, the text in ink.</p>
          <p class="mono"><strong>Where:</strong> the edge only. <strong>Free:</strong> one SVG path, built at build time from a seed.</p>
        </li>
        <li class="v4-item">
          <div class="v4-demo" aria-hidden="true">
            <span class="v4-tape-demo"><span class="fix fix--tape"></span>Masking tape</span>
          </div>
          <h3>Tape</h3>
          <p>A translucent strip with torn ends holds a print to the board. It is the only fixing used.</p>
          <p class="mono"><strong>Where:</strong> the top edge of a print. <strong>Free:</strong> a clipped, translucent box that never blocks a click.</p>
        </li>
        <li class="v4-item">
          <div class="v4-demo v4-demo--mat" aria-hidden="true">
            <figure class="proof__mat v4-mat">
              <span class="proof__crop proof__crop--tl"></span><span class="proof__crop proof__crop--tr"></span><span class="proof__crop proof__crop--bl"></span><span class="proof__crop proof__crop--br"></span>
              <img class="proof__img" src={proof('dhi').src} alt="" width={proof('dhi').width} height={proof('dhi').height} loading="lazy" decoding="async" />
            </figure>
          </div>
          <h3>Proof mat</h3>
          <p>The true-colour screen on paper with crop marks. It opens only when someone asks for it.</p>
          <p class="mono"><strong>Where:</strong> the crop marks and the label. <strong>Free:</strong> four 1px corners, and the image loads on click.</p>
        </li>
        <li class="v4-item">
          <div class="v4-demo v4-demo--cluster" aria-hidden="true">
            <span class="v4-pin" style="left:8%;top:12%;width:44%;--r:-1.2deg"><Print name="dhi" fix="pin" seedKey="sys:pin1" /></span>
            <span class="v4-pin" style="left:52%;top:40%;width:30%;--r:2deg"><Print name="dhi--graph" fix="pin" seedKey="sys:pin2" /></span>
            <span class="v4-pin-title"><span class="mono">01 · Desktop app</span><span class="v4-pin-h">Dhi</span></span>
          </div>
          <h3>Pinboard cluster</h3>
          <p>Two or three prints pinned with a dot, a handwritten title, one margin note and a case study link.</p>
          <p class="mono"><strong>Where:</strong> the angles and the pins. <strong>Free:</strong> transforms, and the board pans without a library.</p>
        </li>
        <li class="v4-item">
          <div class="v4-demo" aria-hidden="true">
            <p class="note v4-annot"><svg class="note__arrow" viewBox="0 0 24 30" focusable="false"><path class="draw" pathLength="1" vector-effect="non-scaling-stroke" d="M9 28 C7 19 11 12 17 5 M12 9 L17 4 L19 11" /></svg><span>Start here if the screen feels off.</span></p>
          </div>
          <h3>Annotation</h3>
          <p>A handwritten note with a pencil arrow. The arrow draws once, the first time it is seen.</p>
          <p class="mono"><strong>Where:</strong> the arrow. <strong>Free:</strong> one stroke animation, static under reduced motion and when JS is off.</p>
        </li>
      </ul>
    </section>

    <section class="sys-section" aria-labelledby="checklist-title">
      <h2 id="checklist-title">Checklist</h2>
      <ul class="checklist" role="list">
        {checks.map((c) => (
          <li><span class="checklist__mark" aria-hidden="true"></span>{c}</li>
        ))}
      </ul>
    </section>

    <section class="sys-section sys-foot">
      <a class="btn btn--primary" href="#home"><svg class="icon-arrow" viewBox="0 0 20 12" aria-hidden="true" focusable="false"><path d="M19 6H2M7 1L2 6l5 5" /></svg>Back to portfolio</a>
    </section>
  </div>
</section>
