---
// Shows the theme it will switch to. Width is fixed, so the label never moves the layout.
---
<button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch to dark theme">
  <svg class="theme-toggle__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
    <circle cx="8" cy="8" r="6.2" />
    <path class="fill" d="M8 1.8a6.2 6.2 0 0 1 0 12.4z" />
  </svg>
  <span data-theme-label>Dark</span>
</button>
