---
import { content } from '../lib/content';

const { footer } = content;
---
<footer class="colophon">
  <div class="wrap grid">
    <p class="colophon-line">{footer}</p>
    <div class="colophon-notes">
      <p class="mono">Set in Archivo, Source Serif 4 and IBM Plex Mono.</p>
      <p class="mono">Astro 5, TypeScript and hand-written CSS. No analytics, no external requests.</p>
      <p class="mono">© 2026 Hardik Thanth · <a href="#top">Back to top</a></p>
    </div>
  </div>
</footer>
