---
import content from '../data/content-v2.json';
import { headingAxes, tilt } from '../lib/seed';

const { person, headlines } = content;
---
<section id="contact" class="section contact" aria-labelledby="contact-title">
  <h2 id="contact-title" style={`font-variation-settings:${headingAxes('contact-title')}`}>{headlines.studio}</h2>

  <div class="plate letter" style={`--tilt:${tilt('letter', ['xs'])}`}>
    <p class="letter__salutation">Dear future client,</p>
    <p>Tell me what you are building, even in a few messy lines. If I am the right fit, we start with a 30-minute intro call, and you get a written plan with scope, timeline and a fixed price within two working days.</p>
    <svg class="signature" viewBox="0 0 240 84" role="img" aria-label="Hardik">
      <path d="M4 66 C10 30 18 14 26 22 C32 30 22 60 18 66 C14 72 26 52 38 36 C48 22 58 22 54 40 C50 58 46 68 56 56 C66 44 74 30 84 30 C96 30 84 60 92 56 C100 52 104 40 112 40 C120 40 118 62 126 56 C134 50 140 34 150 36 C160 38 150 62 160 60 C170 58 176 44 188 42 C198 40 194 62 206 62 C214 62 226 44 236 40" />
    </svg>
  </div>

  <div class="contact__aside">
    <div class="contact__email">
      <a class="email" href={`mailto:${person.email}`} data-email>{person.email}</a>
      <div class="email-row">
        <button type="button" class="btn btn--quiet copy-btn" data-copy-email={person.email}>Copy email</button>
      </div>
      <p class="contact__status" role="status" data-copy-status></p>
    </div>
    <ul class="contact__links" role="list">
      <li><a class="link-hand" href={person.links.github} rel="noopener noreferrer">GitHub<svg class="mark mark--underline" viewBox="0 0 200 12" preserveAspectRatio="none" aria-hidden="true"><use href="#m-underline-b"></use></svg></a></li>
      <li><a class="link-hand" href={person.links.linkedin} rel="noopener noreferrer">LinkedIn<svg class="mark mark--underline" viewBox="0 0 200 12" preserveAspectRatio="none" aria-hidden="true"><use href="#m-underline-b"></use></svg></a></li>
      <li><a class="link-hand" href={person.links.cv} rel="noopener noreferrer">CV (PDF)<svg class="mark mark--underline" viewBox="0 0 200 12" preserveAspectRatio="none" aria-hidden="true"><use href="#m-underline-b"></use></svg></a></li>
    </ul>
    <p class="mono contact__meta">{person.location} · {person.timezone}</p>
  </div>
</section>
