---
import ProjectMock from './ProjectMock.astro';
import SectionHead from './SectionHead.astro';
import { workProjects } from '../lib/content';

// Each row is a native <details>, so it works without JavaScript. The mock preview is
// desktop-hover only (see site.css) and is decorative.
---
<section class="section" id="work" aria-labelledby="work-title">
  <div class="wrap">
    <SectionHead kicker="Selected work" id="work-title" title="Projects" />

    <ol class="work-list" id="work-list">
      {workProjects.map((p) => (
        <li class="work-item" style={`--tone: ${p.accent}`}>
          <details>
            <summary>
              <span class="work-meta">
                <span class="work-year">{p.year}</span>
                <span class="work-type">{p.type}</span>
              </span>
              <h3 class="work-title">{p.title}</h3>
              <span class="work-one">{p.oneLiner}</span>
              <span class="work-toggle" aria-hidden="true">
                <svg viewBox="0 0 20 20" focusable="false"><path class="v" d="M10 4v12" /><path d="M4 10h12" /></svg>
              </span>
            </summary>

            <div class="work-case">
              {p.anonymized && p.client && (
                <p class="work-client"><span class="label">Client</span>{p.client}</p>
              )}
              <dl class="case-lines">
                <div>
                  <dt>Challenge</dt>
                  <dd>{p.challenge}</dd>
                </div>
                <div>
                  <dt>Approach</dt>
                  <dd>{p.approach}</dd>
                </div>
                <div>
                  <dt>Outcome</dt>
                  <dd>{p.outcome}</dd>
                </div>
              </dl>
              <p class="work-stack mono">{p.stack.join(' · ')}</p>
            </div>
          </details>

          <ProjectMock slug={p.slug} />
        </li>
      ))}
    </ol>

    <script>
      // Publishes the cursor position so the floating mock can follow it (desktop pointers only).
      const list = document.getElementById('work-list');
      if (list && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        list.addEventListener('pointermove', (event) => {
          if (event.pointerType !== 'mouse') return;
          const style = document.documentElement.style;
          style.setProperty('--px', `${event.clientX}px`);
          style.setProperty('--py', `${event.clientY}px`);
        });
      }
    </script>
  </div>
</section>
